# Aether Configuration Environment Variables
# Copy this file to .env and adjust values as needed

# =============================================================================
# Ollama Configuration (Local LLM)
# =============================================================================
# URL for Ollama API endpoint
AETHER_OLLAMA_URL=http://127.0.0.1:11434

# Model to use for intent classification and conversation
AETHER_LLM_MODEL=qwen2.5:1.5b-instruct

# Model to use for memory embeddings
AETHER_EMBED_MODEL=nomic-embed-text

# =============================================================================
# Speech Recognition Configuration
# =============================================================================
# Whisper model size: tiny, base, small, medium
AETHER_WHISPER_MODEL=tiny

# Whisper device: auto, cpu, cuda
AETHER_WHISPER_DEVICE=auto

# =============================================================================
# Hotkey Configuration
# =============================================================================
# Enable hotkey listener (set to "1" to enable, "0" to disable)
AETHER_ENABLE_HOTKEY=0

# Hotkey combination (keyboard library format)
AETHER_HOTKEY=win+alt+a

# =============================================================================
# Hive Configuration (Email/Calendar)
# =============================================================================
# Hive API URL
AETHER_HIVE_URL=http://127.0.0.1:8000

# Hive project directory (relative to planner)
AETHER_HIVE_DIR=../hivechild

# =============================================================================
# Data Directories
# =============================================================================
# Data directory for memory, audit logs, and learning data
AETHER_DATA_DIR=planner/data

# =============================================================================
# Advanced Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
AETHER_LOG_LEVEL=INFO

# Maximum utterance length in seconds
AETHER_MAX_UTTERANCE_S=12.0

# Silence detection threshold (RMS)
AETHER_SILENCE_RMS=300

# Silence stop duration in seconds
AETHER_SILENCE_STOP_S=1.5

# Grace period before silence detection
AETHER_GRACE_PERIOD_S=2.0

# =============================================================================
# Development/Debugging
# =============================================================================
# Enable debug mode (verbose logging)
AETHER_DEBUG=0

# Skip safety gate (DANGEROUS - only for development)
AETHER_SKIP_SAFETY=0

# =============================================================================
# Notes
# =============================================================================
# - Set AETHER_ENABLE_HOTKEY=1 for more reliable activation in noisy environments
# - Ensure Ollama is running before starting Aether if using LLM features
# - Vosk model is auto-downloaded to %LOCALAPPDATA%\Aether\ on first run
# - All data is stored locally; no cloud services are used by default
